# Jira Cloud site, e.g. https://your-company.atlassian.net
JIRA_BASE_URL=https://your-company.atlassian.net
# Atlassian account email that owns the API token
JIRA_EMAIL=you@example.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Secret path segment protecting the endpoint: /mcp/<MCP_PATH_SECRET>
# Generate with: openssl rand -hex 32   (min 32 chars)
MCP_PATH_SECRET=

PORT=3000
# 127.0.0.1 = only reachable via the tunnel on this machine (recommended)
HOST=127.0.0.1

# true = register read-only tools only
READ_ONLY=false
# Optional comma-separated project keys that write tools may touch, e.g. ABC,XYZ
# Empty = no restriction
ALLOWED_PROJECTS=

# Team config (default project/board, field names). Re-read on change.
CONFIG_FILE=./jira-mcp.config.json
